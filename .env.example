# Copy to .env (or run `make setup`). Docker Compose fills MySQL settings automatically.

# Server bind — 0.0.0.0 lets other PCs on your LAN reach the API
API_HOST=0.0.0.0
API_PORT=8000

# Published ports on your PC when using Docker Compose (change if already in use)
API_PUBLISH_PORT=8000
MYSQL_PUBLISH_PORT=3307

# Live Google Search via Apify — ON by default on cache miss. Set false to use samples only.
APIFY_ENABLED=true
APIFY_TOKEN=
APIFY_GOOGLE_ACTOR=apify/google-search-scraper
APIFY_GOOGLE_ACTOR_ID=nFJndFXA5zjCTuudP
APIFY_BIGBASKET_ACTOR=soft_alexist/bigbasket-product-details-scraper
APIFY_FLIPKART_ACTOR=khadinakbar/flipkart-product-scraper

# MySQL — only needed for local uvicorn outside Docker. Compose overrides MYSQL_HOST to `mysql`.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=gtin
# MYSQL_PASSWORD=gtin
# MYSQL_DATABASE=gtin

# Cache TTLs
NAME_TTL_DAYS=30
PRICE_TTL_HOURS=12
