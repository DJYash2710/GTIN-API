# Copy to .env and paste your token. Never commit .env.

APIFY_TOKEN=
APIFY_GOOGLE_ACTOR=apify/google-search-scraper
APIFY_GOOGLE_ACTOR_ID=nFJndFXA5zjCTuudP
APIFY_BIGBASKET_ACTOR=soft_alexist/bigbasket-product-details-scraper
APIFY_FLIPKART_ACTOR=khadinakbar/flipkart-product-scraper

# Live Google Search is OFF in this template. Set true in your local .env to test.
# GET spends credits on cache miss or stale price only.
APIFY_ENABLED=false
API_KEY=dev-local-key

# Google Search: desktop + India in code (app/apify_google.py). GTIN query only — no site:/inurl:.
# Collect scripts also require --confirm even if APIFY_ENABLED=true.

# Phase 6 master catalog + lookup cache. If MYSQL_HOST is unset, storage is in-memory (tests).
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=gtin
MYSQL_PASSWORD=
MYSQL_DATABASE=gtin

# Independent cache TTLs (PRD §10). Name/weight 30 days; price 12 hours.
NAME_TTL_DAYS=30
PRICE_TTL_HOURS=12
